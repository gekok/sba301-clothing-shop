# ===== .env.example — template cho file môi trường =====
# Copy file này thành `.env` ở cùng thư mục, điền giá trị thật của máy mình.
# File `.env` đã được gitignore — KHÔNG commit lên repo.
#
# Khi nào cần dùng:
#   - Frontend (Vite) — biến phải có prefix VITE_ để code FE đọc được
#   - Docker compose — đọc qua ${VAR}
#   - Tích hợp service ngoài: SMTP, payment gateway, SMS OTP, cloud storage...
# ============================================================================

# ----- Frontend (Vite) -----
VITE_API_BASE_URL=http://localhost:8080/api

# ----- Backend (Spring Boot) -----
# BẮT BUỘC — backend/application.properties đọc jwt.secret=${JWT_SECRET:...}. Có giá trị default
# dev-only sẵn trong application.properties nên KHÔNG set biến này app vẫn chạy được, nhưng nên tự
# tạo secret riêng cho máy mình (không dùng chung default với người khác).
# Tạo nhanh: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
JWT_SECRET=

# ----- Email / SMTP (tương lai — gửi xác nhận đơn, reset password) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@sba301.local

# ----- Payment gateway (tương lai — VNPay / MoMo) -----
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/checkout/vnpay-return

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# ----- File storage (tương lai — Cloudinary cho ảnh sản phẩm) -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Observability (tương lai — Sentry tracking error) -----
SENTRY_DSN=
